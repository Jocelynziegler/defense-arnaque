# =============================================================================
# En-têtes de sécurité — Ziegler Alerte Arnaque
# =============================================================================

<IfModule mod_headers.c>
  # Empêche le site d'être affiché dans un <iframe> sur un autre domaine
  # (protection contre le détournement de clic / clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Empêche le navigateur de deviner un type de fichier différent de celui
  # réellement déclaré (protection contre certaines attaques par confusion de type MIME).
  Header always set X-Content-Type-Options "nosniff"

  # Limite les informations envoyées au site de destination lors d'un clic
  # sur un lien externe (n'envoie que le domaine, pas l'URL complète avec
  # d'éventuels paramètres sensibles).
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Impose HTTPS pendant 1 an, y compris sur les sous-domaines, une fois le
  # site visité une première fois en HTTPS (protection contre le
  # dégradage forcé vers une connexion non chiffrée).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Désactive l'accès à la caméra, au micro et à la géolocalisation, qui ne
  # sont utilisés nulle part sur ce site.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Content-Security-Policy : whitelist précise des domaines externes
  # réellement appelés par le site (vérifié dans le code — fonts Google,
  # Font Awesome, formulaires FormSubmit, vérification IBAN openiban.com,
  # Google Analytics, API WordPress du cabinet, et le site lui-même).
  #
  # NOTE : 'unsafe-inline' est nécessaire pour script-src et style-src car
  # tout le JavaScript et CSS du site est écrit en blocs <script>/<style>
  # intégrés directement dans les pages (pas de fichiers .js/.css séparés).
  # Une CSP sans 'unsafe-inline' demanderait de réécrire l'intégralité du
  # site avec un système de nonces générés côté serveur — un chantier bien
  # plus lourd que ce contrôle. Cette CSP reste toutefois utile : elle empêche
  # le chargement de scripts/styles depuis un domaine EXTERNE non autorisé
  # (ce qu'un XSS chercherait typiquement à faire pour exfiltrer des données
  # vers un serveur contrôlé par l'attaquant), bloque les <object>/<embed>,
  # et empêche l'affichage du site dans un cadre étranger.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co https://openiban.com https://ziegler-associes.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://www.clarity.ms https://*.clarity.ms; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co"
</IfModule>

# =============================================================================
# Blocage de fichiers sensibles
# =============================================================================

# Empêche l'accès direct au jeton de cron, aux journaux, et aux fichiers
# de configuration Git — même si un lien y menait par erreur.
<FilesMatch "^(cron-secret\.php|cron-secret\.sample\.php|mail-config\.php|push-subscribers\.json|rate-limit\.json|ai-config\.php|ai-verification-rate-limit\.json|ai-verification-monthly-count\.json|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Désactive le listage du contenu d'un dossier si aucun index.html n'y est présent.
Options -Indexes

# =============================================================================
# Vitesse — compression et mise en cache
# =============================================================================

# Compresse les fichiers texte avant envoi (reduction typique de 60-80% de la
# taille transferee pour le HTML/CSS/JS) -- les images et polices sont deja
# compressees dans leur propre format, inutile de les recompresser.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Indique au navigateur combien de temps garder chaque type de fichier en
# cache local, pour eviter de le re-telecharger a chaque visite -- les
# images/polices/icones changent rarement, le HTML peut changer a tout moment.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>
